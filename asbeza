
<
 document.getElementById('trackOrderBtn')?.addEventListener('click', () => {
    const orderId = document.getElementById('orderIdInput').value.trim();
    const resultDiv = document.getElementById('trackResult');
    if (!orderId) {
      resultDiv.innerHTML = '❌ Please enter an order ID.';
      return;
    }
    if (orderId === 'ASB-1001') resultDiv.innerHTML = '🚚 Order delivered! Fresh items received. (Milkrun completed)';
    else if (orderId === 'ASB-1002') resultDiv.innerHTML = '🔄 On milkrun route — delivering to 3 households nearby. ETA 45 min.';
    else resultDiv.innerHTML = `📦 Order ${orderId} is being prepared. You will receive SMS update soon. (Milkrun planned)`;
  });

  // Delivery Scheduling
  document.getElementById('scheduleBtn')?.addEventListener('click', () => {
    const date = document.getElementById('deliveryDate').value;
    if (!date) {
      document.getElementById('scheduleMsg').innerHTML = '⚠️ Please select a delivery date.';
      return;
    }
    document.getElementById('scheduleMsg').innerHTML = `✅ Delivery scheduled for ${date}. Milkrun optimization applied — you will share transport cost with neighbors.`;
  });

  // Cart modal
  const cartOverlay = document.getElementById('cartOverlay');
  const cartIconBtn = document.getElementById('cartIcon');
  const closeCartBtn = document.getElementById('closeCartBtn');
  function showCartModal() { cartOverlay.classList.add('active'); }
  function hideCartModal() { cartOverlay.classList.remove('active'); }
  cartIconBtn.addEventListener('click', showCartModal);
  closeCartBtn.addEventListener('click', hideCartModal);
  cartOverlay.addEventListener('click', (e) => { if(e.target === cartOverlay) hideCartModal(); });
  document.getElementById('checkoutBtn')?.addEventListener('click', () => {
    if(cart.length === 0) alert('Your cart is empty. Add some fresh groceries!');
    else alert(`✅ Thank you! Your order is placed. Milkrun delivery will be arranged. Total: ${cart.reduce((s,i)=>s+(i.price*i.quantity),0)} ETB`);
  });

  // Budget set button
  document.getElementById('setBudgetBtn')?.addEventListener('click', setBudget);

  // Language switcher demo (basic)
  const langSelect = document.getElementById('languageSelect');
  langSelect?.addEventListener('change', (e) => {
    const lang = e.target.value;
    if(lang === 'am') {
      alert("እንኳን ደህና መጡ! ድረ-ገጹ በአማርኛ መስሪያ ላይ ነው (ዲሞ ትርጉም). ባጀት አውጪ እና ምርቶች ተመሳሳይ ናቸው።");
    } else {
      alert("Language set to English. Enjoy fresh groceries!");
    }
  });

  // initialize
  renderProducts();
  updateCartUI();
  // initial budget message
  document.getElementById('budgetMessage').innerHTML = `🎯 Current budget: ${userBudget} ETB. Use planner above.`;
  // optional: connect budget warning after cart changes
  window.updateBudgetWarningBasedOnCart = updateBudgetWarningBasedOnCart;
  // set initial cart total warning
  updateBudgetWarningBasedOnCart();
</script>
</body>
</html>